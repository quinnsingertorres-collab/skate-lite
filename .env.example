# Copy to .env.local for local dev. On Vercel, add these under Settings → Environment Variables.
# Server-only: never prefix with NEXT_PUBLIC_.
SWIFTLY_API_KEY=
# Swiftly agency key (default: mbta). Or set the full URL instead:
# SWIFTLY_AGENCY=mbta
# SWIFTLY_VEHICLES_URL=https://api.goswift.ly/real-time/mbta/vehicles?unassigned=true&verbose=true

# --- Sign-in (required) ---
# Random secret for signing session cookies (32+ characters). Generate with: openssl rand -base64 48
AUTH_SECRET=
# Your admin sign-in (not stored in the database). ID = digits, password = 8+ characters.
ADMIN_ID=
ADMIN_PASSWORD=
# Accounts database: connect Upstash Redis to the Vercel project (Storage tab) and these are added for you
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: prefix for every key sk8 lite stores (default sk8lite:), so a database can be shared
# DB_KEY_PREFIX=sk8lite:
