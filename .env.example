# Copy to .env.local for local dev. On Vercel, add these under Settings → Environment Variables.
# Server-only: never prefix with NEXT_PUBLIC_.
SWIFTLY_API_KEY=
# Swiftly agency key (default: mbta). Or set the full URL instead:
# SWIFTLY_AGENCY=mbta
# SWIFTLY_VEHICLES_URL=https://api.goswift.ly/real-time/mbta/vehicles?unassigned=true&verbose=true
